sgx_status_t send_infomessage(char *encMessageOut, size_t encMessageLen)
{
    uint8_t temp_key[16] = {0x0, 0x1, 0x2, 0x3, 0x4, 0x5, 0x6, 0x7, 0x8, 0x9, 0xa, 0xb, 0xc, 0xd, 0xe, 0xf};

    char *msg_str = "it is the secret";
    struct info_msg_s message;
    int num = 0;
    sgx_read_rand((unsigned char*)&num, sizeof(int));
    message.rand = num;

    struct hash_s hash_val;
    std::copy(std::begin(temp_key), std::end(temp_key), std::begin(hash_val.symkey));
    hash_val.rand = message.rand;

    sgx_status_t status = sgx_sha256_msg((const uint8_t *) &hash_val, sizeof(hash_val), (sgx_sha256_hash_t *)message.hash_rand);

    uint8_t p_dst[2048] = {0};
    status = sgx_rijndael128GCM_encrypt(
            &temp_key, (const uint8_t *)msg_str, strlen(msg_str),
            p_dst + 16 + 12, p_dst + 16, 12, NULL, 0,
            (sgx_aes_gcm_128bit_tag_t *) (p_dst));

    printf("Decrypted message\t %s\n", p_dst);

    memcpy(message.bsm, p_dst, sizeof(p_dst));
    //printf("%s %d\n", message.bsm, message.rand);
    memcpy(encMessageOut, &message, encMessageLen);

    return status;
}

sgx_status_t rcvd_infomessage(char *messageIn, size_t MessageInLen)
{
    struct info_msg_s *message = (info_msg_s *)messageIn;
    struct hash_s hash_val;
    sgx_status_t status;

    hash_val.rand = message->rand;
    uint8_t hash_result[32];
    int idx=0;
    for (symkey_store_s key : symkey_list)
    {
        //memcpy(hash_val.symkey, key.key, sizeof(key.key));
        std::copy(std::begin(key.key), std::end(key.key), std::begin(hash_val.symkey));
        //printf("%d %d %x %x\n", hash_val.rand, message->rand, hash_val.symkey[0], hash_val.symkey[1]);
        sgx_sha256_msg((const uint8_t *) &hash_val, sizeof(hash_val), (sgx_sha256_hash_t *)&hash_result);
        int flag = 0;
        for (int i=0; i<32; i++)
        {
            if (hash_result[i] != message->hash_rand[i])
            {
                flag = 1;
                break;
            }
        }
        if (flag == 0)
        {
            uint8_t *rcvdEncMessage = (uint8_t *) message->bsm;
            uint8_t p_dst[2048] = {0};

            status = sgx_rijndael128GCM_decrypt(
                    &key.key,
                    rcvdEncMessage + 16 + 12,
                    strlen(message->bsm),
                    p_dst,
                    rcvdEncMessage + 16, 12, NULL, 0,
                    (sgx_aes_gcm_128bit_tag_t *) rcvdEncMessage);
            printf("Encrypt success\t %s\n", p_dst);
            symkey_list.erase(symkey_list.begin() + idx);
        }
        idx++;
    }
    //memcpy(hash_val.symkey, rcvd_key, sizeof(rcvd_key));



    return status;
}
